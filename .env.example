# One process serves one console family. `network` (the default) serves the
# controller tools as gateway server `unifi`; `protect` serves the camera
# tools as `unifi-protect`. Each surface reads only its own section below and
# derives its identity JWT audience and default Host allowlist from the
# selector, so run one .env per deployed surface.
UNIFI_MCP_SURFACE=network
UNIFI_MCP_HOST=0.0.0.0
UNIFI_MCP_PORT=8000
UNIFI_MCP_LOG_LEVEL=info
UNIFI_MCP_GATEWAY_BEARER_CURRENT=replace-with-gateway-bearer
# UNIFI_MCP_GATEWAY_BEARER_PREVIOUS=replace-with-previous-gateway-bearer
UNIFI_MCP_IDENTITY_JWKS_URL=http://mcp-gateway:8080/.well-known/jwks.json
UNIFI_MCP_IDENTITY_ISSUER=https://mcp.cacahuate.org
UNIFI_MCP_IDENTITY_ACTOR=mcp.cacahuate.org
# Defaults to the surface's service name (unifi-mcp or unifi-protect-mcp),
# its published port, and loopback; only set this to override that.
# UNIFI_MCP_ALLOWED_HOSTS=unifi-mcp,unifi-mcp:8000

# Network surface (UNIFI_MCP_SURFACE=network). Ignored by a protect process.
UNIFI_MCP_CONTROLLER_URL=https://192.168.0.66
UNIFI_MCP_CONTROLLER_API_KEY=replace-with-integration-api-key
UNIFI_MCP_CONTROLLER_USERNAME=replace-with-local-admin
UNIFI_MCP_CONTROLLER_PASSWORD=replace-with-local-admin-password
# UNIFI_MCP_CONTROLLER_TLS=system | custom-ca | pinned | accept-invalid
# UNIFI_MCP_CONTROLLER_CA_FILE=/etc/unifi-mcp/controller-ca.pem
# A console's own certificate names neither its address nor anything
# resolvable, so `pinned` is how one is trusted without turning validation
# off. List more than one, comma separated, to replace a certificate without
# an outage. See docs/configuration.md for how to read the digest.
# UNIFI_MCP_CONTROLLER_CERT_SHA256=AA:BB:CC:...:FF
# UNIFI_MCP_CONTROLLER_SITE=default
# UNIFI_MCP_CONTROLLER_NAME=unifi

# Protect surface (UNIFI_MCP_SURFACE=protect). Ignored by a network process.
# Its own console, key, and certificate -- not a second site on the
# controller above. URL and key are both required on this surface.
# UNIFI_MCP_PROTECT_URL=https://192.168.0.66
# UNIFI_MCP_PROTECT_API_KEY=replace-with-protect-integration-api-key
# Optional pair enabling historical protect.events through a local session.
# UNIFI_MCP_PROTECT_USERNAME=svc-protect-events
# UNIFI_MCP_PROTECT_PASSWORD=replace-with-local-account-password
# UNIFI_MCP_PROTECT_TLS=system | custom-ca | pinned | accept-invalid
# UNIFI_MCP_PROTECT_CERT_SHA256=AA:BB:CC:...:FF
# UNIFI_MCP_PROTECT_NAME=protect
