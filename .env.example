# Network example. Copy to .env, restrict file access, and supply your values.
# Use --transport stdio or --transport http; this file needs no lab gateway.
UNIFI_MCP_SURFACE=network
UNIFI_MCP_CONTROLLER_URL=https://console.example.net
UNIFI_MCP_CONTROLLER_API_KEY=replace-with-network-integration-key
UNIFI_MCP_CONTROLLER_USERNAME=replace-with-dedicated-local-account
UNIFI_MCP_CONTROLLER_PASSWORD=replace-with-local-account-password
UNIFI_MCP_CONTROLLER_SITE=default
UNIFI_MCP_CONTROLLER_TLS=system
# For custom-ca, set UNIFI_MCP_CONTROLLER_CA_FILE to a readable PEM bundle.
# For pinned, independently verify the console certificate fingerprint first:
# UNIFI_MCP_CONTROLLER_TLS=pinned
# UNIFI_MCP_CONTROLLER_CERT_SHA256=replace-with-verified-sha256-fingerprint

UNIFI_MCP_LOG_LEVEL=info
UNIFI_MCP_ALLOW_WRITES=false
UNIFI_MCP_ALLOW_SECRET_DISCLOSURE=false
# Direct HTTP only: inject a separate random bearer of at least 32 bytes.
# UNIFI_MCP_HTTP_BEARER_CURRENT=replace-with-dedicated-random-bearer
# UNIFI_MCP_HTTP_BEARER_PREVIOUS=replace-with-previous-bearer-during-rotation
# Native direct HTTP defaults to 127.0.0.1:8000.
# UNIFI_MCP_HOST=127.0.0.1
# UNIFI_MCP_PORT=8000
# UNIFI_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
# UNIFI_MCP_ALLOWED_ORIGINS=https://trusted-client.example.net

# Optional gateway mode uses these instead of the direct bearer and grants.
# UNIFI_MCP_GATEWAY_BEARER_CURRENT=replace-with-gateway-bearer
# UNIFI_MCP_IDENTITY_JWKS_URL=https://gateway.example.net/.well-known/jwks.json
# UNIFI_MCP_IDENTITY_ISSUER=https://gateway.example.net
# UNIFI_MCP_IDENTITY_ACTOR=gateway.example.net
