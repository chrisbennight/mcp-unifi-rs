# Protect example. Copy to .env and supply your console URL and Protect key.
UNIFI_MCP_SURFACE=protect
UNIFI_MCP_PROTECT_URL=https://console.example.net
UNIFI_MCP_PROTECT_API_KEY=replace-with-protect-integration-key
UNIFI_MCP_PROTECT_TLS=system
# Optional pair for richer inventory and historical detections:
# UNIFI_MCP_PROTECT_USERNAME=replace-with-dedicated-local-account
# UNIFI_MCP_PROTECT_PASSWORD=replace-with-local-account-password
# For custom-ca, set UNIFI_MCP_PROTECT_CA_FILE to a readable PEM bundle.
# For pinned, independently verify the console certificate fingerprint first:
# UNIFI_MCP_PROTECT_TLS=pinned
# UNIFI_MCP_PROTECT_CERT_SHA256=replace-with-verified-sha256-fingerprint
UNIFI_MCP_LOG_LEVEL=info
# Direct HTTP only: inject a separate random bearer of at least 32 bytes.
# UNIFI_MCP_HTTP_BEARER_CURRENT=replace-with-dedicated-random-bearer
